# Client-visible settings; database access still requires correct Supabase grants and RLS.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Use a publishable key only. Never put a secret or service_role key in a VITE_* variable.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Public VAPID key used by this browser to create Web Push subscriptions.
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key